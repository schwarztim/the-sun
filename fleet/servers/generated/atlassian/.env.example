# atlassian-mcp environment (streamable-HTTP transport).
# MCP_PORT is REQUIRED — the server refuses to start without it.
MCP_HOST=127.0.0.1
MCP_PORT=42015

# --- Your Atlassian site (REQUIRED) ---
# Every Atlassian Cloud site has its own subdomain; there is no usable
# default. The server refuses every tool call with a clear error until this
# is set.
ATLASSIAN_BASE_URL=https://your-domain.atlassian.net

# --- Credential (dual-mode: Hermes broker → env fallback) ---
# HTTP Basic auth: the credential VALUE is "<username>:<token>"
# (e.g. "user@example.com:abc123") — the server base64-encodes it.
#
# EASY ONBOARDING (recommended — broker mode). Enroll the secret in
# Hermes ONCE (the value never touches your shell history):
#   hermes creds set atlassian basic   # reads value from a hidden prompt/stdin
# then point this server at the broker:
# HERMES_URL=http://127.0.0.1:9876
# HERMES_CLIENT_TOKEN=   # from ~/.hermes/client.token
#
# FALLBACK (standalone / no broker) — set ONE (do NOT commit real values):
ATLASSIAN_API_KEY=
ATLASSIAN_TOKEN=
#
# Under fleetd, prefer a hermes:// ref in fleet.toml — fleetd resolves it
# and injects ATLASSIAN_API_KEY into this process's env at spawn.
