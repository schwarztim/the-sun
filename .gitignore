# Dependencies / build output (regenerated by ./install.sh)
**/node_modules/
**/dist/
**/build/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.tsbuildinfo

# Stray package-manager scratch (gateway is npm/package-lock managed; never commit pnpm files here)
gateway/pnpm-lock.yaml
gateway/pnpm-workspace.yaml

# Compiled Go binaries
**/bin/fleetd
**/bin/*-mcp
*-mcp
**/fleetd-stub

# Secrets / vault / env (Hermes owns secrets; nothing sensitive in the repo)
**/.env
**/.env.*
!**/.env.example
**/*.key
**/*.pem
**/*.token
**/secrets.vault
**/master.key

# Local backups / operational one-offs
*.bak
*.bak.*
migrate-*.sh
FORTIFY-VULN-NOTES.md

# OS / editor / logs
.DS_Store
*.log
logs/
.idea/
.vscode/
**/bin/thesun

# SEA build output (regenerated by packaging/sea/build-all.sh)
dist-sea/
